+/** 诊断用：-Drwx.textureFilterStats=true 时每 60000 次贴图绘制打一行 NEAREST/LINEAR 计数。 */
+private object TextureFilterStats {
+    val enabled = System.getProperty("rwx.textureFilterStats", "false") == "true"
+    val nearestCount = java.util.concurrent.atomic.AtomicLong()
+    val linearCount = java.util.concurrent.atomic.AtomicLong()
+
+    private var firstDrawLogged = false
+
+    fun record(useLinear: Boolean) {
+        if (!enabled) return
+        if (!firstDrawLogged) {
+            firstDrawLogged = true
+            io.github.rwx.logger.info { "Slick texture filter stats: recording started" }
+        }
+        val total = if (useLinear) linearCount.incrementAndGet() else nearestCount.incrementAndGet()
+        if (total % 60000L == 0L) {
+            io.github.rwx.logger.info {
+                "Slick texture filter stats: nearest=" + nearestCount.get() + " linear=" + linearCount.get()
+            }
+        }
+    }
+}
+
+private val textureFilterFollowsPaintDisabled: Boolean =
+    System.getProperty("rwx.textureFilterFollowsPaint", "true") == "false"

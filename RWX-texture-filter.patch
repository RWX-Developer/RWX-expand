+    /**
+     * RWX：贴图过滤方式跟随绘制状态，和原版一致。
+     * 原版每次绘制都按 paint 的抗锯齿/filterBitmap 位与贴图自带 imageSmoothing 标志
+     * 现挑 GL_LINEAR / GL_NEAREST（像素单位在 zoom>=1 时走 NEAREST，所以边缘是硬像素）。
+     * RWX 的 Slick 后端此前从不改过滤方式，贴图永远是 Image 创建时的默认 GL_LINEAR ——
+     * 像素画被双线性插值抹开，单位与地形整体发糊。Skia 后端本来就有等价逻辑（见 SkiaGraphicsEngine）。
+     * 想回到旧行为：-Drwx.textureFilterFollowsPaint=false。
+     */
+    private fun textureWantsLinearFilter(texture: Texture?, paint: Paint?): Boolean {
+        if (textureFilterFollowsPaintDisabled) return true
+        return texture?.o == true || paint?.isFilterBitmap() == true || paint?.c() == true
+    }
+
+    private fun applyTextureFilter(image: Image, linear: Boolean) {
+        TextureFilterStats.record(linear)
+        if ((image.filter == GL11.GL_LINEAR) == linear) return
+        // 不在这里 GL.flush()：地图加载时瓦片绘制量以百万计，每切一次都强制同步会把加载拖慢一倍。
+        // 渲染器是 ImmediateModeOGLRenderer（无批处理队列），改过滤方式即时生效，不需要 flush。
+        image.setFilter(if (linear) Image.FILTER_LINEAR else Image.FILTER_NEAREST)
+    }

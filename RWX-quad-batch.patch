+private object TextureFilterStats {
+    val enabled = System.getProperty("rwx.textureFilterStats", "false") == "true"
+    val nearestCount = java.util.concurrent.atomic.AtomicLong()
+    val linearCount = java.util.concurrent.atomic.AtomicLong()
+
+    private var firstDrawLogged = false
